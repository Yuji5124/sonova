{
  "name": "sonova",
  "private": true,
  "version": "1.0.0",
  "description": "SONOVA \u2014 EVERYTHING IS AN INSTRUMENT. Turn non-musical sources into instruments and let them make music together.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sonova/lab",
    "build": "npm run typecheck && npm run build -w @sonova/lab",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "samples": "tsx scripts/make-sample-images.ts",
    "phase1": "tsx scripts/phase1-instruments.ts",
    "phase2": "tsx scripts/phase2-experiments.ts",
    "verify:wav": "tsx scripts/verify-output.ts",
    "soundvault:register": "tsx scripts/soundvault-register.ts",
    "soundvault:verify": "tsx scripts/soundvault-verify.ts",
    "verify:lab": "tsx scripts/verify-lab-browser.ts",
    "rock": "tsx scripts/rock.ts",
    "s002": "tsx scripts/sonova-002.ts",
    "s003": "tsx scripts/sonova-003.ts",
    "s004": "tsx scripts/sonova-004.ts",
    "rock:series": "tsx scripts/rock-series.ts",
    "xrock": "tsx scripts/xrock.ts",
    "toyriot": "tsx scripts/toyriot.ts",
    "toyriot:voices": "tsx scripts/toyriot-voices.ts",
    "od:fetch": "tsx scripts/od-fetch-samples.ts",
    "od:phase2": "tsx scripts/od-phase2.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "playwright-core": "^1.64.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
