  "lyrics": [
    {
      "section": "intro",
      "text": "Good evening. This is Radio Psyence. Close your eyes... the show is about to begin.",
      "sung": "Good evening. This is Radio Psyence. Close your eyes... the show is about to begin.",
      "notes": 0
    },
    {
      "section": "verse1",
      "text": "to-ji-ta ma-bu-ta no / u-ra ga-wa de / da-re mo shi-ra-na-i / ma-ku ga a-ga-ru",
      "sung": "to si ta ma vu ta no u ra ka a te ta re mo si ra na i ma ku ka a ka ru to si ta ma vu ta no",
      "notes": 44
    },
    {
      "section": "verse2",
      "text": "fu-a-n mo i-ka-ri mo / ka-ga-mi no ma-e / ta-no-shi-sa mo / na-mi-da mo na-ra-n-de",
      "sung": "hu an mo i ka ri mo ka ka mi no ma e ta no si sa mo na mi ta mo na ran te hu an mo i ka ri mo",
      "notes": 44
    },
    {
      "section": "pre1",
      "text": "o-to ni na-re / mo-t-to so-to e",
      "sung": "o to ni na re mo to so to e o to",
      "notes": 15
    },
    {
      "section": "pre2",
      "text": "o-to ni na-re / mo-t-to so-to e",
      "sung": "o to ni na re mo to so to e o to",
      "notes": 15
    },
    {
      "section": "pre3",
      "text": "o-to ni na-re / mo-t-to so-to e",
      "sung": "o to ni na re mo to so to e o to",
      "notes": 15
    },
    {
      "section": "chorus1",
      "text": "ポケットの宇宙 / 知らない色 / 胸の奥 ショーが始まる / 光れ サイロー！",
      "sung": "ポケトノウチュウシラナイイロムネノオクショガハジマルヒカレサイロ",
      "notes": 30
    },
    {
      "section": "chorus2",
      "text": "ポケットの宇宙 / 知らない色 / 胸の奥 ショーが始まる / 光れ サイロー！",
      "sung": "ポケトノウチュウシラナイイロムネノオクショガハジマルヒカレサイロ",
      "notes": 30
